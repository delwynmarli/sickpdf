<?xml version="1.0" encoding="utf-8"?>
<!--
  sickPDF adaptive launcher foreground.

  One continuous folded-ribbon S drawn as a round-capped, round-joined stroke,
  so it stays a single unbroken shape at every launcher size.

  Sizing (measured, not guessed): the S is 44.5 x 51 dp with a max radius of
  30.98 dp from the canvas centre.
    - 2.02dp clear inside the 66dp guaranteed-safe circle
    - 5.02dp clear inside the 72dp area circular/squircle masks can reveal
  The charcoal background comes from ic_launcher_background; no mask is baked
  into this foreground.

  Matches assets/branding/sickpdf-s-monogram.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Continuous folded-ribbon S monogram. -->
    <path
        android:pathData="M69.25,40 C69.25,35.5 65.25,35.5 59.25,35.5 C51.25,35.5 44.25,38 41.25,44 C38.75,49 41.25,54 47.25,57 C55.25,60 63.25,62 66.25,67 C69.25,71 66.25,72.5 60.25,72.5 C52.25,72.5 44.25,70 40.25,65"
        android:strokeColor="#147D73"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Minimal folded-paper cue, tucked inside the upper ribbon. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M59,31.5 L66.5,31.5 L63.5,38.5 L56,38.5 Z" />
</vector>
