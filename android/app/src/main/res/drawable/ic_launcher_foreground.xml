<?xml version="1.0" encoding="utf-8"?>
<!--
  sickPDF launcher foreground: a simplified document sheet with a folded corner
  and three content lines. Drawn inside the safe zone of the 108dp adaptive
  canvas so no important detail is clipped by circular/squircle masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Document sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,30 L60,30 L72,42 L72,78 A4,4 0 0 1 68,82 L40,82 A4,4 0 0 1 36,78 L36,34 A4,4 0 0 1 40,30 Z" />

    <!-- Folded corner -->
    <path
        android:fillColor="#202321"
        android:fillAlpha="0.22"
        android:pathData="M60,30 L72,42 L60,42 Z" />

    <!-- Content lines -->
    <path
        android:fillColor="#202321"
        android:pathData="M43,48 L65,48 L65,51.5 L43,51.5 Z" />
    <path
        android:fillColor="#202321"
        android:pathData="M43,57 L65,57 L65,60.5 L43,60.5 Z" />
    <path
        android:fillColor="#147D73"
        android:pathData="M43,66 L58,66 L58,69.5 L43,69.5 Z" />
</vector>
