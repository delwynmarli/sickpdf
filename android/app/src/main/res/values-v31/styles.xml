<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ uses the platform SplashScreen API. A matching background and
      centered brand mark are shown while the Flutter engine warms up, so there
      is no flash or layout jump into the real UI.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
